{
  "name": "task-board",
  "version": "1.0.0",
  "private": true,
  "description": "やること・進行中・完了の3列で管理するタスクボード",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "db:migrate": "node --env-file-if-exists=.env src/migrate.js",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
